  m_Script: {fileID: 11500000, guid: 20c5b2c7536c2cc409890d1076ea1545, type: 3}
  m_Name: Merchant
  m_EditorClassIdentifier: 
  speaker: Merchant
  dialogues:
  - npcLines:
    - Good day.
    choices:
    - choiceText: Who are you?
      nextDialogueID: 4
  - npcLines:
    - Good day. Again.
    choices:
    - choiceText: I'd like to buy.
      nextDialogueID: 2
    - choiceText: I don't have money.
      nextDialogueID: 7
  - npcLines:
    - Of course you do.
    - '[SHOP]'
    choices: []
  - npcLines:
    - You will come back.
    - '[END]'
    choices: []
  - npcLines:
    - I sell things and recycle whatever you got.
    - Well, what do people call that...
    choices:
    - choiceText: Merchant?
      nextDialogueID: 5
    - choiceText: A homeless scavenger.
      nextDialogueID: 6
  - npcLines:
    - Right, right, right!
    - Here, check out my stuff!
    - '[SHOP]'
    choices: []
  - npcLines:
    - You don't have many friends, do you.
    - '[END]'
    choices: []
  - npcLines:
    - These scarecrows will drop some mana-polluted parts.
    - I'll pay a fair price if you can bring them to me.
    - '[END]'
    choices: []
